# release.env.example — App Store Connect API 認証情報 (BasePod)
#
# このファイルを `release.env` にコピーして実値を埋める。
# `release.env` は .gitignore 済みでコミットされない。
#
# 使い方:
#   cp scripts/release.env.example scripts/release.env
#   # release.env を編集して値を埋める (chmod 600 推奨)
#   bash scripts/release.sh

# === App Store Connect API ===
# 発行: https://appstoreconnect.apple.com → ユーザーとアクセス → 統合
# 役割は Admin or App Manager 推奨

# Key ID (10文字のID、ファイル名 AuthKey_<ID>.p8 と同じ)
API_KEY_ID=

# Issuer ID (UUID形式)
API_KEY_ISSUER=

# === Optional: signing override ===
# Cloud signing 自動取得が機能しない場合、ここで Team ID を上書き
# (通常は ExportOptions-iOS.plist の teamID を使うので未設定で OK)
# DEVELOPMENT_TEAM=

# === Optional: スキップフラグ ===
# C6 Sim 検証 (起動 + screenshot + ios_app_validator.sh) を飛ばしたい場合 1
# 通常は未設定 (= 必ず実施) を推奨
# SKIP_C6_SIM=

# Web layer (pnpm build + cap sync) を飛ばしたい場合 1
# 直前の build を流用してスピード再アップロードしたい時のみ
# SKIP_WEB_BUILD=
